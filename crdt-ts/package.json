{
  "name": "@concord/crdt",
  "version": "0.1.0",
  "description": "Concord's CRDT engine: OR-Set existence, LWW attributes, fractional ordering keys and an HLC. Pure, no I/O.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "test",
    "vectors",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').cpSync('../conformance/vectors','vectors',{recursive:true})\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
